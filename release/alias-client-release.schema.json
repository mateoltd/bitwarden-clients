{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/mateoltd/bitwarden-clients/blob/fix/public-alias-review-findings/release/alias-client-release.schema.json",
  "title": "Alias client release manifest",
  "type": "object",
  "required": [
    "schemaVersion",
    "releaseLane",
    "cleanHistoryInputs",
    "canonicalSdk",
    "testInfrastructure",
    "clientToolchain",
    "targets",
    "handoff"
  ],
  "properties": {
    "schemaVersion": { "const": 1 },
    "releaseLane": {
      "type": "object",
      "required": ["branch", "baseCommit", "sourceRepository", "upstreamRepository"]
    },
    "cleanHistoryInputs": {
      "type": "object",
      "required": ["clientV1Commit", "releaseCheckpointCommit", "arm64FixCommit", "stateOnly"]
    },
    "canonicalSdk": {
      "type": "object",
      "required": [
        "package",
        "version",
        "artifact",
        "provenance",
        "provenanceSha256",
        "candidateChecksums",
        "candidateChecksumsSha256",
        "buildEnvironment",
        "buildEnvironmentSha256",
        "toolchainHandoff",
        "toolchainHandoffSha256",
        "producerToolchain",
        "sha256",
        "integrity",
        "sourceCommit",
        "publicRef",
        "aliasReferenceSchemaVersion",
        "workflow"
      ],
      "properties": {
        "producerToolchain": {
          "type": "object",
          "required": ["runnerImage", "node", "npm", "rust", "wasmOpt"]
        }
      }
    },
    "testInfrastructure": { "type": "object" },
    "clientToolchain": {
      "type": "object",
      "required": [
        "node",
        "cliNode",
        "npm",
        "python",
        "rust",
        "electron",
        "electronBuilder",
        "playwright"
      ]
    },
    "targets": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "family", "runner", "artifactFormat", "smoke"]
      }
    },
    "handoff": { "type": "object" }
  }
}
