    },
    {
      "id": "swift-package",
      "platforms": [
        "swift"
      ],
      "instruction": "Extract the Swift archive, consume its BitwardenSdk package and BitwardenFFI.xcframework together, and remove any separately generated alias bindings."
    },
    {
      "id": "kotlin-jvm-package",
      "platforms": [
        "kotlinJvm"
      ],
      "instruction": "Place the versioned JAR and matching host native library on the same runtime path, then remove any separately generated alias bindings."
    },
    {
      "id": "android-package",
      "platforms": [
        "android"
      ],
      "instruction": "Add the versioned AAR as the sole Android SDK binary and remove any separately generated alias bindings or native libraries."
    },
    {
      "id": "current-reference-schema",
      "platforms": [
        "typescriptWasm",
        "swift",
        "kotlinJvm",
        "android"
      ],
      "instruction": "Persist only the SDK's canonical alias reference schema version 1: version, connectionId, opaque bounded aliasId, and canonical address. Reject missing, zero, malformed, provider-specific, and unknown future shapes; do not migrate old unreleased values or infer bindings from usernames or addresses."
    },
    {
      "id": "encrypted-connection-metadata",
      "platforms": [
        "typescriptWasm",
        "swift",
        "kotlinJvm",
        "android"
      ],
      "instruction": "Store adapter identifiers, endpoints, labels, capabilities, and credentials only in the encrypted connection record. Never copy them into alias references, vault bindings, journals, telemetry, or logs."
    },
    {
      "id": "provider-pin",
      "platforms": [
        "typescriptWasm",
        "swift",
        "kotlinJvm",
        "android"
      ],
      "instruction": "Use the provider commit recorded in providerPin when reproducing the real SimpleLogin lifecycle gate."
    }
  ],
