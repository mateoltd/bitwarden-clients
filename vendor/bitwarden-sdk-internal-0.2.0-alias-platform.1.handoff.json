    },
    {
      "id": "android-package",
      "platforms": [
        "android"
      ],
      "instruction": "Add the versioned AAR as the sole Android SDK binary and remove any separately generated alias bindings or native libraries."
    },
    {
      "id": "current-reference-schema",
      "platforms": [
        "typescriptWasm",
        "swift",
        "kotlinJvm",
        "android"
      ],
      "instruction": "Persist only current-schema alias references created and parsed by the SDK; reject unsupported schemas and do not infer bindings from usernames or addresses."
    },
    {
      "id": "provider-pin",
      "platforms": [
        "typescriptWasm",
        "swift",
        "kotlinJvm",
        "android"
      ],
